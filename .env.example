# Copy to .env and fill in. Never commit .env (see .gitignore).

# --- Database (Supabase) ---
# Session pooler (5432) is REQUIRED for the LangGraph PostgresSaver checkpointer
# (it uses psycopg prepared statements; the 6543 transaction pooler does not support them).
DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are intentionally NOT used by any code here -
# the app talks to Postgres directly via DATABASE_URL (see app/db.py) and never calls
# the Supabase Data API/PostgREST, which is the point of the RLS lockdown in
# migrations/0002_rls_lockdown.sql. Do not add these back without re-reading that file -
# the service-role key bypasses RLS entirely. Left here only as a reminder not to add them.

# --- CRM ---
# "supabase" is the safe default: Approve keeps working forever, even after a GHL trial expires.
# Set to "gohighlevel" only when you want the live demo to show the real CRM integration.
CRM_PROVIDER=supabase
GHL_PIT_TOKEN=
GHL_LOCATION_ID=
GHL_PIPELINE_ID=

# --- LLM ---
# A free OpenRouter model. nvidia/nemotron-3.5-super-vl:free is live-verified
# against this project's actual intake/content prompts: 5-20s, clean JSON, no
# markdown fences, correctly resists prompt injection. Avoid
# nvidia/nemotron-3.5-lightning:free for the content node specifically -
# verified to degenerate into 100+s of whitespace-token generation on the
# larger structured-drafting prompt (fine for intake's simpler classification).
LLM_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_API_KEY=

# --- Telegram (operator draft-waiting ping) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Twilio WhatsApp sandbox (optional demo conversation loop) ---
# Join the sandbox from TWILIO_SANDBOX_DEMO_TO by texting "join <code>" to +14155238886.
# Point the sandbox inbound webhook to ${PUBLIC_BASE_URL}/webhooks/twilio/whatsapp.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SANDBOX_DEMO_TO=whatsapp:+916001507395
# When true, Approve sends the drafted reply via Twilio (within the 24h free-form window).
# When unset/false, behaviour stays log-only (sent_log only, no live send).
TWILIO_WHATSAPP_SEND=
# Public HTTPS origin (ngrok) used for Twilio signature validation and Console webhook URL.
PUBLIC_BASE_URL=

# --- Webhook auth ---
DESK_WEBHOOK_SECRET=

# --- Command centre basic auth ---
DESK_BASIC_AUTH_USER=
DESK_BASIC_AUTH_PASS=

# --- Policy ---
CORPUS_STALE_DAYS=45

# --- Demo ---
# Overrides "now" for date resolution in intake, so the demo stays reproducible after Nov 2026.
DEMO_NOW=
